# Flask
FLASK_SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production

# Database (SQLAlchemy connection string, PyMySQL driver)
# Local example: mysql+pymysql://in_motors_app:app-password@localhost:3306/in_motors_dev
# Managed host example: mysql+pymysql://user:password@host:3306/database?ssl=true
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/in_motors

# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp number used across the public site (digits only, country code, no +)
WHATSAPP_NUMBER=258867596098

# Used ONLY by scripts/create_admin.py to create/reset the single owner account.
# Do not leave these set in production after the account is created.
ADMIN_EMAIL=owner@inmotors.mz
ADMIN_PASSWORD=change-this-strong-password
